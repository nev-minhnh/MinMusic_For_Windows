{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM"], "jsx": "preserve", "jsxImportSource": "solid-js", "types": ["node"]
  },
  "include": ["./**/*.ts"]
}
