{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MinMusic",
  "version": "2.0.0",
  "identifier": "nev-minhnh.MinMusic",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "MinMusic",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*; img-src 'self' https: http://127.0.0.1:* data: blob:; media-src 'self' http://127.0.0.1:*",
      "devCsp": "default-src 'self' http://localhost:5173; script-src 'self' 'unsafe-inline' http://localhost:5173; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:* ws://localhost:5173 http://localhost:5173; img-src 'self' https: http://127.0.0.1:* http://localhost:5173 data: blob:; media-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "nev-minhnh",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Vietnamese",
          "English"
        ],
        "installerHooks": "nsis/hooks.nsh",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "MinMusic",
    "longDescription": "MinMusic for Windows: YouTube Music client",
    "copyright": "Copyright (c) nev-minhnh",
    "category": "Music",
    "resources": {
      "../sidecar/dist/runtime": "core/runtime",
      "../sidecar/dist/lib": "core/lib",
      "../sidecar/dist/core.args": "core/core.args",
      "../sidecar/dist/core.jsa": "core/core.jsa"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "minmusic",
          "metrolist",
          "metrolist-auth"
        ]
      }
    },
    "minmusic": {
      "channel": "alpha",
      "displayVersion": "2.0.0"
    },
    "updater": {
      "endpoints": [
        "https://github.com/nev-minhnh/MinMusic_For_Windows/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5MkE2RTNCQTFFNTNGMzIKUldReVArV2hPMjRxaVhnV0xkN3o0L1NOV2VEbUZFbXBCcnphYkV6dmpCODVMbXdyQjRpWDlueFYK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
