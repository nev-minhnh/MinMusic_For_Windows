{
  "name": "minmusic-windows",
  "private": true,
  "version": "2.0.0",
  "description": "MinMusic for Windows v2 (Tauri 2 shell + Kotlin core sidecar + SolidJS UI)",
  "workspaces": [
    "ui",
    "protocol",
    "mock-core",
    "tests/contract"
  ],
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:real": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Real",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "schema": "npm -w protocol run schema",
    "shell:test": "cargo test --manifest-path src-tauri/Cargo.toml --target x86_64-pc-windows-gnu",
    "shell:build": "cargo tauri build --target x86_64-pc-windows-gnu --features e2e --no-bundle"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "jsdom": "26.1.0",
    "solid-js": "1.9.20",
    "@playwright/test": "1.65.1",
    "vite": "7.3.1",
    "vite-plugin-solid": "2.11.17"
  }
}
